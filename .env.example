# ─────────────────────────────────────────────────────────────
# El Depósito — variables de entorno
# Copiar a .env.local (desarrollo) o configurar en Vercel / VPS.
# ─────────────────────────────────────────────────────────────

# Supabase (Auth + Realtime). Panel → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio (enlaces en correos, SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (solo servidor). Supabase → Connect → "Transaction pooler" (puerto 6543)
# En el VPS: postgres://deposito:CLAVE@db:5432/deposito
DATABASE_URL=

# Zona horaria del negocio
BUSINESS_TIMEZONE=America/Bogota

# Secreto para firmar enlaces de gestión de reservas (>= 32 caracteres).
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ¡Debe ser el MISMO en todos los entornos que compartan base de datos!
RESERVAS_SECRETO=

# Correo: 'consola' (solo registra, desarrollo) o 'resend' (envío real)
EMAIL_PROVEEDOR=consola
RESEND_API_KEY=
# Remitente con dominio verificado en Resend, p. ej. El Depósito <reservas@tudominio.com>
EMAIL_REMITENTE=
EMAIL_RESPONDER_A=
# Correos del equipo que reciben aviso de cada reserva nueva (separados por coma)
EMAIL_AVISOS_NEGOCIO=

# Protege /api/cron/recordatorios (Vercel Cron lo envía en el header Authorization)
CRON_SECRET=
