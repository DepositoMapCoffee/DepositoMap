# ─────────────────────────────────────────────────────────────
# El Depósito — variables de entorno
# Copiar a .env.local (desarrollo) o configurar en Vercel / VPS.
# ─────────────────────────────────────────────────────────────

# Supabase (Auth + Realtime). Panel → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio (enlaces en correos, SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (solo servidor). Supabase → Connect → "Transaction pooler" (puerto 6543)
# En el VPS: postgres://deposito:CLAVE@db:5432/deposito
DATABASE_URL=

# Zona horaria del negocio
BUSINESS_TIMEZONE=America/Bogota
